# Environment template for the local dev runner.
# This is a TEMPLATE only (note the ".example" suffix) — no real secrets.
# Real secrets live in the company secret manager under path
# "ci/runner/env". Safe to delete; recreating it from the team-template
# repo is one command away.

RUNNER_ENV=development
LOG_LEVEL=info
EMBEDDING_CACHE_DIR=/tmp/embed_cache
MAX_PARALLELISM=4